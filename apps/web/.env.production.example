# URL of the deployed Cortex API used by the server-side proxy. Do not include
# a trailing slash. Browser requests remain on the web app's own origin.
API_PROXY_TARGET=https://your-cortex-api.onrender.com

# Keep this set for Docker-based builds that pass the API target as a build arg.
NEXT_PUBLIC_API_URL=https://your-cortex-api.onrender.com

# Optional. Set only when the API has CORTEX_API_KEY enabled.
# This value is embedded in the browser bundle and is not a private secret.
NEXT_PUBLIC_CORTEX_API_KEY=
