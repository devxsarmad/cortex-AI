PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=5
AI_TEMPERATURE=0.3
CORTEX_API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AI_INPUT_COST_PER_1K_TOKENS=0
AI_OUTPUT_COST_PER_1K_TOKENS=0
CORTEX_DATA_DIR=.cortex-data
DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex?schema=public
DIRECT_URL=postgresql://cortex:cortex@localhost:5432/cortex?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX_REQUESTS=10
IMPORT_DEFAULT_EMAIL=owner@cortex.local
IMPORT_DEFAULT_PASSWORD=change-me-now
IMPORT_DEFAULT_ORGANIZATION=Default Organization
GEMINI_API_KEY=
VECTOR_STORE_PROVIDER=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cortex_chunks
